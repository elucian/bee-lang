-- @DESC: custom type with default constructor (O3)
type T: {a1: 10, a2: 5};

rule main:
  -- named attributes are optional
  new obj1 := T(a2: 0);

  -- positional attributes
  new obj2 := T(1, 10);

  expect obj1 = {a1: 10, a2: 0};
  expect obj2 = {a1: 1, a2: 10};
return;

-- spec/06-objects.md §6 object_type; tutorial/objects.html "Custom type":
-- a `type` declaration with default attribute values lets the compiler build
-- a default constructor reused by the type name.
-- @AI: No - assertion-only (self-verifying)
-- @DISABLED: default-object-constructor auto-generation is not implemented
