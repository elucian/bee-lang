+---------------------------------------------
-- @DESC: anonymous object via JSON literal
--        and member access (O1)
----------------------------------------------+
rule main:
  -- anonymous object
  new obj := {name: "Cleopatra", age: 15};

  -- dot-notation member access
  expect obj.name = "Cleopatra";

  -- index-notation member access
  expect obj["age"] = 15;
  expect obj.age = 15;

  -- introspect the universal root type
  expect type(obj) = "Object";
  expect obj is Object;
return;

+--------------------------------------------------------
spec/06-objects.md §2.2: anonymous object instantiation
via JSON literal; members read with dot notation: `.name`
and index notation `["age"]`.
---------------------------------------------------------+
