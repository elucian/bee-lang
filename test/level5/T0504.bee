+-----------------------------------------------------------
-- @DESC: object constructor rule with public members (O4)
-----------------------------------------------------------+
rule Foo(a, b ∈ N) => (self ∈ Object):
  -- public properties (self. prefix)
  new self.a := a;
  new self.b := b;
return;

rule main:
  -- instantiation dispatches through the constructor
  new test := Foo(1, 2);

  -- verify exported attributes
  expect test.a = 1;
  expect test.b = 2;

  -- the instance type matches the constructor name
  expect type(test) = "Foo";
  expect test is Object;
return;

+------------------------------------------------------------
spec/06-objects.md §2.1 / tutorial/objects.html "Object
constructor": a constructor rule binds its result to `self`
and exports `.member`s.
------------------------------------------------------------+
