+-------------------------------------------------------------
-- @DESC: public method definition and apply invocation (O5)
-------------------------------------------------------------+
rule Foo(a, b ∈ N) => (self ∈ Foo):
  new self.a := a;
  new self.b := b;

  -- public method
  rule .sum(self ∈ Foo) => (r ∈ N):
    let r := self.a + self.b;
  return;
return;

rule main:
  new test := Foo(3, 4);

  -- apply the public method via the returned object
  apply test.sum;

  -- method result must equal the sum of the attributes
  expect test.sum = 7;
return;

