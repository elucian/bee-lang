+----------------------------------------------------------
-- @DESC: encapsulation of private vs public members (O6)
----------------------------------------------------------+
rule Counter(initial ∈ N) => (self ∈ Counter):
  new self.count := initial;
  new sentinel  := 99; -- private: no self. prefix

  -- public accessor method
  rule .value(self ∈ Counter) => (r ∈ N):
    let r := self.count;
  return;
return;

rule main:
  new c := Counter(5);

  -- public member reachable on the instance
  expect c.value = 5;

  -- sentinel
  expect

  -- private member is not exported: reading c.sentinel must fail/unbound
  assert c.value = 5;
return;

