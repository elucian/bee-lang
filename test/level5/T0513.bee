+------------------------------------------------
-- @DESC: serialize whole object canonical JSON (M3)
------------------------------------------------+
new obj := {name: "Cleopatra", age: 15};

rule main:
  print obj;
return;

+------------------------------------------------
tutorial/objects.html "Serialization": printing
a bare object identifier renders its members as
a sorted, quoted JSON-like string.
------------------------------------------------+
-- @AI: Yes
-- @EXPECT: {age: 15, name: "Cleopatra"}
