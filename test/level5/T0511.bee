+------------------------------------------------
-- @DESC: recursive node object structure (O11)
------------------------------------------------+
type Node: {
  data ∈ Z,
  next ∈ @Node? -- optional reference to Node
} <: Object;

rule main:
  -- bottom-up allocation ensures symbols are bound before assignment
  new n3 := {data: 3, next: nil};
  new n2 := {data: 2, next: n3};
  new n1 := {data: 1, next: n2};

  -- walk the chain with explicit or safe navigation
  expect n1.data = 1;
  expect n1.next?.data = 2;
  expect n1.next?.next?.data = 3;
  expect n1.next?.next?.next = nil;
return;

+--------------------------------------------------------
tutorial/objects.html "Recursive Structures": a type
referencing another instance of itself to form a tree /
linked list.
--------------------------------------------------------+
