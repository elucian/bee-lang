+------------------------------------------------------------
-- @DESC: coroutine channel extraction yield r << task (C4)
------------------------------------------------------------+
rule ticker(n ∈ N) => (r ∈ N):
  for i ∈ (1..n) do
    let r := i;
    yield;
  done;
  let r := 0;
return;

rule main:
  begin ticker(4);

  new acc ∈ N := 1;
  new got ∈ N := 0;

  while acc > 0 do
    yield acc << ticker; -- extract next yielded value
    let got += acc;
  done;

  wait;

  -- expected: 1 + 2 + 3 + 4 = 10
  expect got = 10;
return;

+-------------------------------------------------------------
spec/12-concurrency.md §4.2: `yield r << coroutine` extracts
the next yielded value from an active coroutine; yields the
sequence then a 0 sentinel.
-------------------------------------------------------------+
-- @AI: No - assertion-only (self-verifying)
-- @DISABLED: the `yield var << coroutine` channel and `yield` are not
-- implemented in the evaluator.