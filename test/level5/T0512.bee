+------------------------------------------------
-- @DESC: print object members via dot access (M2)
------------------------------------------------+
new obj := {name: "Cleopatra", age: 15};

rule main:
  print obj.name, obj.age;
return;

+------------------------------------------------
tutorial/objects.html "Member Access": dot
notation reads the stored string and numeric
members of an anonymous object.
------------------------------------------------+
-- @AI: Yes
-- @EXPECT: Cleopatra 15
