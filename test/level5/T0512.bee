-- @DESC: async begin and wait barrier (C1)
-- worker rule: returns double its argument
rule test(n ∈ Z) => (r ∈ Z):
  let r := n * 2;
return;

rule main:
  -- spawn 4 concurrent workers
  for ∀ i ∈ (1..4) do
    begin test(i);
  done;

  -- mandatory barrier: block until all workers finish
  wait;
return;

-- spec/12-concurrency.md §2: `begin task(...)` spawns an isolated worker
-- thread; `wait;` is a mandatory synchronization barrier before scope exit.
-- @AI: No - assertion-only (self-verifying)
-- @DISABLED: `begin`/`wait` are lexed but not executed by the evaluator.
