-- @DEBT: Compose operator `∘` (`f ∘ g` composes two lambdas into a new lambda, spec/07 §5) is unimplemented. `new h := f ∘ g;` is an E0009 syntax error. Requires lexer COMPOSE token, parser precedence entry, and evaluator lambda-composition logic. See tracking/issues/21-lambda-operator-extensions.md.
-- @DESC: Compose operator — f ∘ g applies g then f, spec/07 §5
-- @AI: No - self-sufficient: assertion-only, no stdout.
rule main:
  new f := λ(x ∈ Z) => (x + 1) ∈ Z;
  new g := λ(x ∈ Z) => (x * 2) ∈ Z;
  new h := f ∘ g;
  expect h(5) = 11;
return;
