-- @DESC:file: array_traversal.bee
-- array traversal demo
use $pro_lib.console:(*);

-- array with 10 elements
new a ∈ [Z](10);

rule main:
                                        -- array initialization
                                        -- Fix: 1-based indexing correction (0..9)
  for i ∈ (0..9) do
    let a[i] := i;
  repeat;

                                        -- array traversal and print
  for i ∈ (0..9) do
    print " a[#(i)] = #(a[i])";
  repeat;
return;

