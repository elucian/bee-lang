-- @DESC: Pipe operator — value |> f |> g threads a value through transformations, spec/07 §5
-- @AI: No - self-sufficient: assertion-only, no stdout.
-- @DISABLED: Pipe operator `|>` is unimplemented: `5 |> double |> inc` is an E0009 syntax error (spec/07 §5).
rule main:
  new double := λ(x ∈ Z) => (x * 2) ∈ Z;
  new inc := λ(x ∈ Z) => (x + 1) ∈ Z;
  new result := 5 |> double |> inc;
  expect result = 11;
return;
