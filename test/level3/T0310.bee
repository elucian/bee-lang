-- @DESC: Closures state capture — rule returns a closure with boxed mutable state
rule counter_generator(start ∈ Z) => (next ∈ Rule):
  set .count := [start];
  rule .next() => (val ∈ Z):
    let .count += 1;
    let val := .count;
  return;
return;

rule main:
  new c := counter_generator(1);
  print c.next();
  print c.next();
  expect c.next()=4;
return;
