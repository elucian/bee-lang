-- @FROZEN: Generated from /spec/. Immutable ground truth for AI agents.
-- @DESC: Early return with exit — exit terminates rule early with current result, spec/03 §3.2
rule main:
  new count ∈ Z;
  let count := 0;
  if count = 0 do
    print "early exit";
    exit;
  done;
  print "should not reach here";
return;
