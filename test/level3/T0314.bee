-- @DESC: Multi-result deconstruction — a rule returning two values binds to q and r in one call, spec/03 §2.3
-- @AI: No - self-sufficient: assertion-only, no stdout.
rule divmod(a ∈ Z, b ∈ Z) => (q, r ∈ Z):
  let q := a / b;
  let r := a % b;
return;

rule main:
  new q, r := divmod(17, 5);
  expect q = 3;
  expect r = 2;
return;
