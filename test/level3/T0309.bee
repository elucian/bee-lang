-- @DESC: Scoping variable locality — a rule-local variable never leaks into the caller's scope, spec/03 §4
-- @AI: No - self-sufficient: assertion-only, no stdout.
rule helper => (v ∈ Z):
  new local_var ∈ Z;
  let local_var := 42;
  let v := local_var;
return;

rule main:
  new h := helper();
  expect h = 42;
  new outer ∈ Z;
  let outer := 7;
  expect outer = 7;
return;
