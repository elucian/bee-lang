-- @DESC: Compose operator — f ∘ g applies g then f, spec/07 §5
-- @AI: No - self-sufficient: assertion-only, no stdout.
-- @DISABLED: Compose operator `∘` is not approved:
-- @FROZEN: `new h := f ∘ g;` is an E0009 syntax error (spec/07 §5).
rule main:
  new f := λ(x ∈ Z) => (x + 1) ∈ Z;
  new g := λ(x ∈ Z) => (x * 2) ∈ Z;
  new h := f ∘ g;
  expect h(5) = 11;
return;
