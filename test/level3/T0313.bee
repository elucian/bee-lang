-- @DESC: Recursion — factorial computed via a recursive rule call, spec/03 §3
-- @AI: No - self-sufficient: assertion-only, no stdout.
rule factorial(n ∈ N) => (r ∈ N):
  if n ≤ 1 do
    let r := 1;
    exit;
  done;
  let r := n * factorial(n - 1);
return;

rule main:
  new f := factorial(5);
  expect f = 120;
return;
