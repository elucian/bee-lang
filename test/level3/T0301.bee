-- @DESC:file: append_collection_example.bee
-- A rule that adds an item to a collection and uses `old`
-- to verify the size increased by exactly one.

rule append_item(items ∈ @[Z], new_val ∈ Z):
  expect length(items) = length(old items) + 1;
  expect items[length(items)-1] = new_val;
  let append(items, new_val);
return;

