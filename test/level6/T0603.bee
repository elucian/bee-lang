-- @DISABLED: E0009 SyntaxError:UnrecognizedStatement: line=15 type=; literal=";"
-- @DESC:file: trial_pass_fail.bee
-- pass, fail and abort demo
rule main:
  trial:
  try:
    print "a";
    pass;
    print "skipped";
  try:
    fail 500, "noted";
  try:
    print "code is " + $error.code;
  final
    print "done";
  done;
return;

