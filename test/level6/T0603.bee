+------------------------------------------------------------
-- @DESC: trial prologue scope and final cleanup (E6)
------------------------------------------------------------+
rule main:
  new finalized := 0;
  trial tx:
    new budget := 100;     -- prologue: enclosing scope for the trial
  try
    raise {code: 501, message: "kaboom"};
  case $error.code = 501 do
    expect $error.message = "kaboom";  -- handler reads the error object
    expect budget = 100;               -- prologue locals visible here
  final
    let finalized := 1;    -- unconditional finalisation
  done;
  expect finalized = 1;
return;
+------------------------------------------------------------
spec/02-statements.md §4: the optional `trial label :` prologue
is an enclosing scope visible to try/case/error/final; `final`
runs unconditionally after recovery; `case` guards match the
current `$error`.
------------------------------------------------------------+
