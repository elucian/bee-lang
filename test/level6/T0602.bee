-- @DISABLED: E0009 SyntaxError:UnrecognizedStatement: line=11 type=; literal=";"
-- @DESC:file: trial_miss.bee
-- miss catches the rest demo
rule main:
  trial:
    try:
        raise 999, "unknown";
    case $error.code = 1 do
        print "wrong";
    miss
        print "missed " + $error.code;
  done;
return;
