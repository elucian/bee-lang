+------------------------------------------------------------
-- @DESC: collection of lambda callbacks invoked (E6)
------------------------------------------------------------+
rule main:
  new inc := λ(x ∈ Z) => (x + 1) ∈ Z;
  new dbl := λ(x ∈ Z) => (x * 2) ∈ Z;
  new ops := {'inc': inc, 'dbl': dbl};
  expect ops['inc'](5) = 6;
  expect ops['dbl'](5) = 10;
return;
