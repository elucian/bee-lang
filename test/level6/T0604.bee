+------------------------------------------------------------
-- @DESC: resume continues after failing statement (E6)
------------------------------------------------------------+
rule main:
  new step := 0;
  try
    let step := 1;
    raise {code: 500, message: "boom"};
    let step := 2;         -- normally skipped; reached via `resume`
  case $error.code = 500 do
    resume;                -- continue at the statement after `raise`
  done;
  expect step = 2;
return;
+------------------------------------------------------------
spec/02-statements.md §4: `resume` continues execution at the
statement after the one that failed, so the remainder of the
protected region runs to completion after a handled error.
------------------------------------------------------------+
