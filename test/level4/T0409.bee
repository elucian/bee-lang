-- @DESC: contract store item in collection
-- @AI: No - self-sufficient assertion test
-- A rule that stores an item into a collection cell demo;
-- collections pass by share (spec/10), so the caller
-- verifies the stored value after apply returns.

rule store_item(items ∈ [Z], pos ∈ Z, new_val ∈ Z):
  assert pos >= 1;
  let items[pos] := new_val;
return;

rule main:
  new xs := [10, 20, 30];
  apply store_item(xs, 3, 99);
  expect xs[3] = 99;
  expect xs[1] = 10;
return;
