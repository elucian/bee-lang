-- @DESC:file: concatenation.bee
-- Concatenation demo
rule main:
-- array concatenation can create garbage
  new c := [1,2] + [3];
  expect c[1] = 1;
  expect c[2] = 2;
  expect c[3] = 3;
  expect c = [1,2,3];
-- test concatenation for lists, no garbage
  new l := (1,2); -- list of two elements
  new m := (3,);  -- list with one element
  new cm := l + m;
  expect cm[1] = 1;
  expect cm[2] = 2;
  expect cm[3] = 3;
  expect cm = (1,2,3);
return;
