-- @DESC:T0436 array and hash-map builders over stepped range (spec/11 §4, spec/10 §3)
rule main:
  -- array builder: [ x | x ∈ (1..10)(2) ] => [1,3,5,7,9]
  new arr := [ x | x ∈ (1..10)(2) ];
  expect arr[1] = 1;
  expect arr[2] = 3;
  expect arr[3] = 5;
  expect arr = [1,3,5,7,9];

  -- hash-map builder with step + filter (D13 postfix step)
  new mymap := { (x : x²) | x ∈ (2..<10)(2) ∧ (x % 2 = 0) };
  expect mymap[2] = 4;
  expect mymap[4] = 16;
  expect mymap[6] = 36;
  expect mymap[8] = 64;
  -- deep comparison with literal (value comparison)
  expect mymap = { 2:4, 4:16, 6:36, 8:64 };

  print "T0436 builder assertions passed";
return;
