-- @DESC: growing a list with <+ and +>
-- @AI: No - self-sufficient assertion test
-- List growth demo (spec/01 coll_op): <+ appends at the end,
-- +> appends at the beginning (pipeline/map-reduce pattern).
rule main:
  new l := (2,3);
  let l <+ 4;
  let l +> 1;
  expect l[1] = 1;
  expect l[2] = 2;
  expect l[3] = 3;
  expect l[4] = 4;
  expect l = (1,2,3,4);
return;