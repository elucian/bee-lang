-- @DESC: set/array builders over a filtered or stepped range, matched against hardcoded collections (spec/10 §3, spec/11)
-- @AI: No - self-sufficient assertion test
rule main:
  -- set builder with filter, 1-based domain (1..6) => {2,4,6}
  new evens := { x | x ∈ (1..6) ∧ (x % 2 = 0) };
  expect evens = {2,4,6};

  -- set builder with mapping rule x² over 1..4 => {1,4,9,16}
  new squares := { x² | x ∈ (1..4) };
  expect squares = {1,4,9,16};

  -- array builder over stepped range (D13 postfix step) => [1,3,5,7,9]
  new arr := [ x | x ∈ (1..10)(2) ];
  expect arr = [1,3,5,7,9];

return;
