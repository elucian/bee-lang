-- @DESC: contract clamp with named results
-- Both, naming results and parameters demo
rule clamp(v, lo, hi ∈ Z) => (r ∈ Z):
  expect lo ≤ hi;
  expect lo ≤ r ≤ hi;
  let r := v;
  if v < lo do
    let r := lo;
  else if v > hi do
    let r := hi;
  done;
return;

rule main:
  expect clamp(-5,0,10) = 0;
  expect clamp(5,0,10) = 5;
  expect clamp(99,0,10) = 10;
return;
