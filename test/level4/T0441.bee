-- @DESC: set algebra intersection, union, symmetric difference (spec/10 §3.4)
rule main:
  new s1 := {1,2,3,4,5};
  new s2 := {3,4,5,6,7};
  new common := s1 ∩ s2;
  expect 3 ∈ common;
  expect 4 ∈ common;
  expect 5 ∈ common;
  expect 1 !∈ common;
  expect 7 !∈ common;

  new total := s1 ∪ s2;
  expect 1 ∈ total;
  expect 2 ∈ total;
  expect 7 ∈ total;
  expect 5 ∈ total;

  print "T0441 set algebra assertions passed";
return;