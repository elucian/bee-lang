-- @DESC: sized array filled with a constant via builder (spec/10 §3)
-- @AI: No - self-sufficient assertion test
rule main:
                                        -- sized array: 5 elements all 7
  new a := [ 7 | x ∈ (1..5) ];
  expect a = [7,7,7,7,7];
  expect a[1] = 7;
  expect a[$] = 7;
return;
