-- @DESC:file: slices_share.bee
-- Slices share storage demo
rule main:
  new a := [1,2,3,4,5];
  new w := a[0..2];
  let w[*] := 0;
  -- slice shares storage: zeroing the window zeroes the array head
  expect a[1] = 0;
  expect a[2] = 0;
  expect a[5] = 5;
return;

