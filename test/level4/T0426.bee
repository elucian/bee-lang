-- @DESC: slice extraction with $ anchor
-- @AI: No - self-sufficient assertion test
-- Slice extraction demo (spec/10 §2.3): sub-collections are
-- extracted with range operators; $ is the dynamic end anchor.
rule main:
  new a := [1,2,3,4,5];
  new w := a[2..$ - 1];
  expect w[1] = 2;
  expect w[2] = 3;
  expect w[3] = 4;
  expect w = [2,3,4];
return;