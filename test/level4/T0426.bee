-- @DESC:T0426 slice extraction with $ anchor
-- Slice extraction demo (spec/10 §2.3): sub-collections are
-- extracted with range operators; $ is the dynamic end anchor.
rule main:
  new a := [1,2,3,4,5];
  new w := a[2..$ - 1];
  expect w[1] = 2;
  expect w[2] = 3;
  expect w[3] = 4;
  print w; expect w = [2,3,4];
return;
