-- @DESC: list concatenation and append/shift operators (spec/10 §3.1, spec/11 list ops)
-- @AI: No - self-sufficient assertion test
rule main:
  -- list concatenation with `+` creates a new list
  new a := (1,2,3);
  new b := (4,5,6);
  new c := a + b;
  expect c = (1,2,3,4,5,6);
  expect c[1] = 1;
  expect c[$] = 6;

  -- append one element to end of list with `<+`
  new q := (1,2,3);
  let q <+ 4;
  expect q = (1,2,3,4);
  expect q[1] = 1;
  expect q[$] = 4;

return;
