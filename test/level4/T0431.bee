-- @FROZEN: Generated from /spec/. Immutable ground truth for AI agents.
-- @DESC:T0431 dollar-anchor arithmetic and array processing with asserts
rule main:
  	-- Array literal and $-anchor (spec/10 §2.1, §3.2)
  	new a := [10, 20, 30, 40];
  	expect a[1] = 10;
  	expect a[$] = 40;
  	expect a[$-1] = 30;
  	expect a[$-3] = 10;

  -- Indexed mutation via $-anchor relatives (spec/10 §3.2)
  let a[$] := 99;
  expect a[4] = 99;
  expect a[$] = 99;

  -- Processing pipeline: sum elements in a 1..n loop (spec/11 §1)
  new total := 0;
  new n := 4;
  for i ∈ (1..n) do
    let total := total + a[i];
  done;
  expect total = 10 + 20 + 30 + 99;

  -- Copy and process a second collection with a decreasing loop
  new b := [1, 2, 3, 4, 5];
  new acc := 0;
  for j ∈ (1..5) do
    let acc := acc + b[$ - j + 1];
  done;
  expect acc = 15;

  print "T0431 dollar-anchor assertions passed";
return;
