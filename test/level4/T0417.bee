-- @DESC: map literal index/extend/cut with integer values (spec/10 §3.5)
-- @AI: No - self-sufficient assertion test
rule main:
  new m := {1:10, 2:20};
  expect m[1] = 10;
  expect m[2] = 20;

                                        -- extend the map
  let m[3] := 30;
  expect m[3] = 30;

                                        -- remove a key; remaining entries intact
  cut m[1];
  expect 1 !∈ m;
  expect m[2] = 20;
  expect m[3] = 30;
return;
