-- @DESC:T0439 array decomposition, spreading, and rendering (spec/11 §5.1)
rule main:
  -- deconstruction: head elements plus *tail
  new x, y, *rest := [1,2,3,4,5];
  expect x = 1;
  expect y = 2;
  expect rest[1] = 3;
  expect rest[2] = 4;
  expect rest[3] = 5;
  expect rest[$-1] = 4;

  print "T0439 decomposition assertions passed";
return;
