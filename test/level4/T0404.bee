-- @DISABLED: E0009 SyntaxError:UnrecognizedStatement: line=5 type=; literal=";"
-- @DESC:T0404 contract grow on a collection
-- old works on a collection too demo
rule grow(items ∈ [Z], by ∈ Z):
  assert by >= 0;
  expect items.length = old items.length + by;
  let items ++ by;
return;

rule main:
  new xs ∈ [Z](2);
  print xs.length;
  apply grow(xs, 3);
  print xs.length;
return;

