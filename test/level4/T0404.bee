-- @DESC: contract grow on a collection
-- A rule that stamps a collection cell demo; collections pass
-- by share (spec/10), so the caller verifies the mutation
-- after apply returns.
rule stamp(items ∈ [Z], pos ∈ Z, val ∈ Z):
  assert pos >= 1;
  let items[pos] := val;
return;

rule main:
  new xs := [10, 20, 30];
  apply stamp(xs, 2, 99);
  expect xs[2] = 99;
  expect xs[$] = 30;
  print xs[2];
return;
