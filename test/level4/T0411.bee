-- @DESC: array traversal with done terminator (D14)
-- @AI: No - self-sufficient assertion test
-- D14: for loop terminates with done;.
-- 1-based array indexing (Decision 1).

-- array with 10 elements
new a ∈ [Z](1..10);

rule main:
                                        -- array initialization
  for i ∈ (1..10) do
    let a[i] := i;
  done;

                                        -- array traversal and print
  for i ∈ (1..10) do
    expect a[i] = i;
  done;
return;
