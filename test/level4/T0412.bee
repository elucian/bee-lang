-- @DESC:T0304 bubble sort with done terminators (D14)
-- D14: cycle/for terminator migrated to done;.
rule main:
  new a := [5, 4, 3, 2, 1];
  new n := 5;
  cycle sort:
    new swapped: True ∈ B;
    while swapped do
      let swapped := False;
      for i ∈ (1..n-1) do
        if a[i] > a[i+1] do
          let a[i], a[i+1] := a[i+1], a[i];
          let swapped := True;
        done;
      done;
      let n -= 1;
  done sort;
  expect a[1] = 1;
  expect a[2] = 2;
  expect a[3] = 3;
  expect a[4] = 4;
  expect a[5] = 5;
return;

