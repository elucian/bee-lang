-- @DISABLED: E0009 SyntaxError:InvalidCycleHeader: line=5 (expected `âˆˆ` or `in` after for-index identifier; got type=, literal=",")
-- @DESC:T0319 walking a map with done terminator (D14)
-- D14: for loop terminates with done;.
rule main:
  new m := {1:"a", 2:"b"};
  for k, v ∈ m do
    write k + "=" + v + " ";
  done;
  print;
return;

