-- @DESC: walking a map with done terminator, summing values (D14, spec/10 §3.5)
-- @AI: No - self-sufficient assertion test
-- D14: for loop terminates with done;.
rule main:
  new m := {1:10, 2:20};
  new total := 0;
  for k, v ∈ m do
    let total := total + v;
  done;
  expect total = 30;
return;
