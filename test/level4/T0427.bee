-- @DISABLED: map iteration string values evaluate to 0 (unimplemented, spec/10 §3.5)
-- @DESC: walking a map with done terminator (D14)
-- D14: for loop terminates with done;.
rule main:
  new m := {1:"a", 2:"b"};
  for k, v ∈ m do
    write k + "=" + v + " ";
  done;
  print; -- 1 = a 2 = b
return;