-- @DESC: matrix row/column slice mutation and broadcast (spec/11 §5.2)
-- @AI: No - self-sufficient assertion test
rule main:
  new M ∈ [Z](2,2);
  -- broadcast assignment to all elements via [*]
  let M[*] := 100;
  expect M[1,1] = 100;
  expect M[1,2] = 100;
  expect M[2,1] = 100;
  expect M[2,2] = 100;

  -- modify an entire row
  let M[1,*] := 0;
  let M[2,*] := 1;
  expect M[1,1] = 0;
  expect M[1,2] = 0;
  expect M[2,1] = 1;
  expect M[2,2] = 1;

return;