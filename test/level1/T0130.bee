-- @DESC: Equality and identity relational operators
rule main:
  new a, b ∈ Z;
  let a := 10;
  let b := 10;

  expect a = 10;   -- value equality
  expect a ¬ 20;  -- inequality (<>)
  expect a is not 20;  -- inequality (is not)
  expect a = a;    -- identity
  expect a is a;   -- identity (is)
  expect a = b;    -- equality with b
return;
