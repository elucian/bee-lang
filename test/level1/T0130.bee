-- @DISABLED: === VARIABLE CONTEXT ===
-- @FROZEN: Generated from /spec/. Immutable ground truth for AI agents.
-- @DESC:T0130 Equality and identity relational operators
rule main:
  new a ∈ Z; new b ∈ Z;
  let a := 10;
  let b := 10;

  expect a = 10;   -- value equality
  expect a <> 20;  -- inequality (<>)
  expect a != 20;  -- inequality (!=)
  expect a = a;    -- identity
  expect a == a;   -- identity (==)
  expect a = b;    -- equality with b
return;
