-- @DESC: file print_write.bee
-- print and write demo
rule main:
  write "no";
  write " newline";
  print;
  print "then one";
  expect True;
return;

-- spec/02 Decision 6: write accumulates output without a newline until the bare print flushes the line.
-- @AI: Yes - write emits no newline until the bare print; stdout must be exactly "no newline\nthen one".
-- @EXPECT: no newline\nthen one
