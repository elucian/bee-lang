-- @DESC: file hello_world.bee
-- hello world demo
rule main:
  write "Hello";
  write " ";
  write "World";
  print;
  print "done";
return;

-- spec/02 Decision 6: write emits without a newline; a bare print terminates the line (io_stmt rule_call wrapper).
-- @AI: Yes - write emits no newline while print terminates the line; stdout must be exactly "Hello World\ndone".
-- @EXPECT: Hello World\ndone
