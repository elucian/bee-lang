-- @DESC: Decision 11: parenthesised parallel colon-initialisation
-- Parallel colon-initialisation binds N=2 identifiers to M=2 expressions (N = M),
-- all sharing the single trailing type qualifier.
rule main:
  new (a, b) : (1, 2) ∈ Z;
  expect a = 1;
  expect b = 2;
return;

