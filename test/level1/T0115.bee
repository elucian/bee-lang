-- @DESC: Exercises several print output forms (blank, str, int, tuple, multi-arg, floats).
-- @AI: Yes - multiple print-output forms verified byte-exact.
-- @EXPECT: \nHello, Bee!\n42\nNumber: 100\nMultiple arguments 365 passed\n42 43 44\n3.14
rule main:
  print;
  print "Hello, Bee!";
  print 42;
  print ("Number:", 100);
  print "Multiple", "arguments", 365, "passed";
  print 42, 43, 44;
  print 3.14;
return;
