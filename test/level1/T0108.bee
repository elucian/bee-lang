-- @DISABLED: === VARIABLE CONTEXT ===
// @FROZEN: Generated from spec. Immutable ground truth for AI agents.
-- T0108: Compound assignment and update operators
-- (`+=`, `-=`, `*=`, `/=`, `%=`, `^=`, `√=`)
rule main:
  new a ∈ Z;
  let a := 10;
  let a += 5;
  expect a = 15;
  let a -= 3;
  expect a = 12;
  let a *= 2;
  expect a = 24;
  let a /= 4;
  expect a = 6;
  let a %= 4;
  expect a = 2;
  let a ^= 3;
  expect a = 8;
  let a √= 3;
  expect a = 2;
return;
