-- @DESC: file initial_values.bee
-- Initial values demo
rule main:
  -- initialization with individual values
  new a: 1, b: 2 ∈ Z;
  expect a = 1;
  expect b = 2;

  -- initialization in series with one value
  new x,y,z ∈ Z: 2;
  expect x + y + z = 6;
return;

-- spec/02 §2.1: colon-initialisation with individual values (new a: 1, b: 2 ∈ Z) and the series form (new x, y, z ∈ Z: 2) binding one value to every cell.
-- @AI: No - assertion-only (self-verifying)
