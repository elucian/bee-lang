-- @DESC: Chained compound mutation on type-inferred cells
rule main:
  new x := 10;          -- type inference form; no explicit `∈ Z`
  let x += 5;
  expect x = 15;
  let x *= 2;
  expect x = 30;
  new y := 7;
  let y -= 2;
  expect y = 5;
  expect x = 30;        -- independent cell unaffected by y
return;