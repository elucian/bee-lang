-- @DESC: Decision 13: fully-exclusive legacy `!!` still lexes as `>..<`
-- The legacy `!!` form preserves fully-exclusive semantics and emits a non-fatal E0010 deprecation.
rule main:
  new a ∈ Z;
  let a := 5;
  expect a in (1..10); -- 5 ∈ (1, 10)
  expect not (1 in (1>..10));
  expect not (10 in (1..<10));
return;

-- spec/05 §3.2 (Decision 13): the legacy !! form lexes to the canonical exclusive operator with a non-fatal E0010 deprecation.
-- @AI: No - assertion-only (self-verifying)
