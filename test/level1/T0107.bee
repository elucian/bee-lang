-- @DISABLED: === VARIABLE CONTEXT ===
-- @ENABLED: Re-enabled after fractional exponent root refactoring
-- T0107: Square root, cube root, and radical operators (`²√`, `³√`, `⁴√`) and superscripts
rule main:
  new x ∈ Z;
  let x := 27;
  expect ²√ 9 = 3;
  expect ³√ x = 3;
  expect ⁴√ 16 = 2;
  expect ³√ 2³ = 2;
  expect (1 + 2)³ = 27;
  expect 144^(1/2) = 12;
  expect 625^(1/4) = 5;
  expect 1000^(1/3) = 10;
return;
