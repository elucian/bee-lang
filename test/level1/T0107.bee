-- @DESC: Square root, cube root, and radical operators
rule main:
  new x ∈ Z;
  let x := 27;
  expect ²√9 = 3;
  expect ³√x = 3;
  expect ⁴√16 = 2;
  expect ³√ 2³ = 2;
  expect (1 + 2)³ = 27;
  expect ²√144 = 12;
  expect ⁴√625 = 5;
  expect ³√1000 = 10;
return;

-- spec/01 §3.4: radical operators — prefix ²√ ³√ ⁴√ n-th roots, postfix superscript power ³, and the composed form ³√ 2³.
-- @AI: No - assertion-only (self-verifying)
