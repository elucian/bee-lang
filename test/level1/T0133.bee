-- @FROZEN: Generated from /spec/. Immutable ground truth for AI agents.
-- @DESC: T0133 Decision 13: fully exclusive range `>..<` semantics
-- Open `(a, b)` — both endpoints excluded.
rule main:
  new mid ∈ Z;
  let mid := 5;

  expect mid in (1>..<10);       -- 5 ∈ (1, 10)
  expect not (1 in (1>..<10));   -- 1 NOT in (1, 10)
  expect not (10 in (1>..<10));  -- 10 NOT in (1, 10)
  expect 2 in (1>..<3);          -- 2 ∈ (1, 3)
return;
