-- @DESC: Decision 13: fully exclusive range `>..<` semantics
-- Open `(a, b)` — both endpoints excluded.
rule main:
  new mid:5 ∈ Z;
  expect mid in (1>..<10);       -- 5 ∈ (1, 10)
  expect not (1 in (1>..<10));   -- 1 NOT in (1, 10)
  expect not (10 in (1>..<10));  -- 10 NOT in (1, 10)
  expect 2 in (1>..<3);          -- 2 ∈ (1, 3)
return;

-- spec/05 §3.2 + spec/02 §2.1 (Decision 13): fully exclusive >..< — open (a, b) interval, both endpoints excluded.
-- @AI: No - assertion-only (self-verifying)
