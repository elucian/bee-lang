-- @DESC: Exponentiation and power operators
rule main:
  new base, exp, res ∈ Z;
  let base := 2;
  let exp := 3;
  let res := base ^ exp;
  expect res = 8;
  expect base ^ exp = 8;
return;

-- spec/01 §3.4: exponentiation operator ^ — integer power 2³ = 8 asserted directly and via a cell.
-- @AI: No - assertion-only (self-verifying)
