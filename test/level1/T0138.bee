-- @DESC: Decision 13: postfix-step with fully-exclusive range `>..<`
-- Stepping a fully-exclusive postfix range (1,5) yields three elements {2,3,4}.
rule main:
  new r ∈ [Z];
  new a ∈ Z;
  new b ∈ Z;
  new c ∈ Z;

  let r := (1>..<5)(1);
  let a := r[1];
  let b := r[2];
  let c := r[3];

  expect a = 2;
  expect b = 3;
  expect c = 4;
return;