-- @DESC: The print statement writes a computed integer expression to stdout.
rule main:
  new a ∈ Z;
  let a := 10 + 3;
  print a;
  expect a = 13;
return;

-- spec/02 Decision 6: print writes a computed integer expression (10 + 3) to stdout.
-- @FROZEN: Generated from /spec/. Immutable ground truth; kept so AI agents never rewrite the print io assertion.
-- @AI: Yes - computed integer printed, verified byte-exact.
-- @EXPECT: 13
