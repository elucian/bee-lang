-- @FROZEN: Generated from /spec/. Immutable ground truth for AI agents.
-- @DESC: T0134 Decision 13: postfix-step range indexing (integer step)
-- `(1..5)(1)` discretises the closed range into a 5-element sequence; `[3]` returns the 3rd element (1-based) = 3.
rule main:
  new stepped ∈ Z;
  new third ∈ Z;
  new first ∈ Z;

  let stepped := (1..5)(1);
  let first := stepped[1];
  let third := stepped[3];

  expect first = 1;   -- [1] -> 1
  expect third = 3;   -- [3] -> 3
return;
