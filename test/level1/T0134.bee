-- @DESC: Decision 13: postfix-step range indexing (integer step)
-- A stepped postfix range yields a 5-element closed sequence; rank-3 indexing gives the third element (1-based) = 3.
rule main:
  new stepped ∈ [Z];
  new third ∈ Z;
  new first ∈ Z;

  let stepped := (1..5)(1);
  let first := stepped[1];
  let third := stepped[3];

  expect first = 1;   -- [1] -> 1
  expect third = 3;   -- [3] -> 3
return;

-- spec/05 §3.3: postfix step application (1..5)(1) discretises the closed range into a 5-element sequence; 1-based [i] indexing.
-- @AI: No - assertion-only (self-verifying)
