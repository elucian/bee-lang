-- @DESC: Test assignment, equality (=), and inequality (¬) operators
rule main:
  new a ∈ Z; new b ∈ Z; new r1 ∈ Z; new r2 ∈ Z;
  let a := 42;
  let b := 42;
  expect a = 42;
  let r1 := a = b;
  expect a = 42;
  expect r1 = 1;
  let b := 100;
  expect b = 100;
  expect a = 42;
  let r2 := a ¬ b;
  expect r2 = 1;
return;

-- spec/01 §3.3: value equality = and canonical inequality ¬ (Decision 2 + Decision 12); spec/02 §2.2: let rebinding preserves cell identity.
-- @AI: No - assertion-only (self-verifying)
