-- @DESC: Essential arithmetic operations and assignments
rule main:
  new a, b, c, d, e ∈ Z;
  let a := 10 + 3;
  expect a = 13;
  let b := 10 - 3;
  expect b = 7;
  let c := 10 * 3;
  expect c = 30;
  let d := 10 / 3;
  expect d = 3;
  let e := 10 % 3;
  expect e = 1;
return;

-- spec/01 §3.4: arithmetic operators + - * / and modulo with integer semantics; spec/02 §2.2: let := mutation of new-declared cells.
-- @AI: No - assertion-only (self-verifying)
