-- @DESC: Decision 13: postfix-step with left-exclusive range `>..`
-- Stepping a left-exclusive postfix range (1,5] yields four elements {2,3,4,5}.
rule main:
  new r ∈ [Z];
  new a ∈ Z;
  new b ∈ Z;
  new c ∈ Z;
  new d ∈ Z;

  let r := (1>..5)(1);
  let a := r[1];
  let b := r[2];
  let c := r[3];
  let d := r[4];

  expect a = 2;
  expect b = 3;
  expect c = 4;
  expect d = 5;
return;

-- spec/05 §3.3 (Decision 13): stepped left-exclusive range (1>..5)(1) — (1, 5] discretised to 2 3 4 5.
-- @AI: No - assertion-only (self-verifying)
