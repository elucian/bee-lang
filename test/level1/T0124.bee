-- @DISABLED: Spec 05 marks Str immutable and spec 01 mutates only on arithmetic cells (+=, -=); string mutation/equality is unimplemented (E0303). Kept as honest gap signal.
-- @DESC: String compound mutation: `+=` concatenates in place
-- @NOTE: This test contains ≠ that is deprecated in favor of
rule main:
  new s ∈ Str;
  let s := "foo";
  let s += "bar";
  expect s = "foobar";
  let s += "!";
  expect s = "foobar!";
  expect s ≠ "foobar"; -- deprecated
  expect s ¬ "foobar"; -- correct
return;
