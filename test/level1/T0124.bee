-- @DESC: String compound concatenation: `+=` rebinds to concat (spec/02 §2.2)
-- @NOTE: String `+=` rebinds to concatenation; superseded value reclaimed by Tier-3 GC (spec/00 §2.3).
rule main:
  new s ∈ Str;
  let s := "foo";
  let s += "bar";
  expect s = "foobar";
  let s += "!";
  expect s = "foobar!";
  expect s ¬ "foobar";
return;