-- @DESC: String compound concatenation: `+=` rebinds to concat (spec/02 §2.2)
rule main:
  new s ∈ Str;
  let s := "foo";
  let s += "bar";
  expect s = "foobar";
  let s += "!";
  expect s = "foobar!";
  expect s ¬ "foobar";
return;

-- spec/02 §2.2: string compound concatenation — += on Str rebinds to the freshly allocated concat; the superseded value is reclaimed by the Tier-3 generational GC (spec/00 §2.3).
-- @AI: No - assertion-only (self-verifying)
