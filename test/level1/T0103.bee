-- @DESC: Logical and boolean Unicode operators
rule main:
  new p, q ∈ Z;
  let p := 1;
  let q := 0;
  expect p ∧ p;
  expect p ∨ q;
  expect p ⊕ q;
  expect !q;
  expect !(p ∧ q);
return;

-- spec/01 §3.6: logical operator synonymy (Decision 7) — ∧ ∨ ⊕ and ! with 1/0 integer truth values.
-- @AI: No - assertion-only (self-verifying)
