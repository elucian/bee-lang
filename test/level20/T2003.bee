+----------------------------------------------
-- @DESC: coroutine generator with yield (C22)
----------------------------------------------+
rule ticker(n ∈ N) => (v ∈ N):
  for i ∈ (1..n) do
    let v := i;
    yield; -- suspend and yield control
  done;
  let v := 0; -- finalization signal
return;

rule main:
  -- reference used by the consumer loop (seeded to enter)
  new r ∈ N := 1;

  -- instantiate the coroutine task
  begin ticker(3);
  wait;
return;

+-------------------------------------------------------
spec/12-concurrency.md §4.1: a rule containing `yield`
suspends its frame and acts as a stateful generator,
emitting one value per resume.
-------------------------------------------------------+
-- @AI: No - assertion-only (self-verifying)
-- @DISABLED: `yield`/coroutine suspension is not implemented.