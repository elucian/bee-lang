-- @DISABLED: E0009 SyntaxError:UnrecognizedStatement: line=8 type=; literal=";"
-- @ENABLED: Reset by user
-- @ENABLED: Reset by user
-- @DESC:T0201 Basic variable initialization
rule main:
  new a, b, c ∈ Z;          -- explicit declare 3 variable
  expect a = b = c = 0;     -- default value is zero
  new x, y, z := 1, 2, 3;   -- type inference, mapping
  expext x + y + z = 6;     -- check all 3 in one go
  new xo, yo, zo ∈ Z = 10;  -- explicit pair-up;
  expect xo = 10 and yo = 10 and zo = 10;
  expect xo = yo snd zo = yo and zo = xo;
return;
