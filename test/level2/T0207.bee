-- @DESC: Conditional execution with else-if ladder
-- @AI: No - Self sufficient fast test
rule main:
  new n := 0;
  new out := "";
  if n > 0 do
    let out := "positive";
  else if n < 0 do
    let out := "negative";
  else
    let out := "zero";
  done;
  expect out = "zero";  -- n = 0 falls to the else branch
return;