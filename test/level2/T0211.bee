-- @DESC: Labeled nested cycle: cross-label next skips the inner tail (D14)
-- @AI: No - Self sufficient fast test
-- D14: `next outer` jumps to the next outer iteration, skipping the inner tail.
rule main:
  cycle outer:
    new i ∈ Z;
    new cells := 0;
  for i ∈ (1..2) do
    for j ∈ (1..3) do
      next outer if j = 2;  -- cross-label: jump to next outer at j=2
      let cells += 1;       -- reached cells: j=1 only (j=2 jumps, j=3 skipped)
    done;
    let cells += 10;        -- outer tail: never reached (next outer fires at j=2)
  done outer;
  expect cells = 2;  -- j=1 over 2 passes; tail +10 would make 22 if not skipped
return;