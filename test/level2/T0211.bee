-- @DESC:T0211 Labeled nested cycles with cross-label stop (D14)
-- D14: labels are jump targets for stop/next/redo.
rule main:
  cycle outer:
    new i ∈ Z := 0;
  do
    cycle inner:
    for ∀ y ∈ (1..3) do
      stop outer if y = 9;
      next outer if y = 2;
      write y;
    done inner;
  done outer;
return;

