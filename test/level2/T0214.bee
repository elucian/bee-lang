-- @DESC: Redo directive restarts current iteration (D14)
-- @AI: No - Self sufficient fast test
-- D14: `redo` re-evaluates the loop header without flushing volatile body state.
rule main:
  cycle:
    new attempts := 0;
    new succeeded := 0;
  do
    let attempts += 1;
    redo if attempts < 3;
    let succeeded += 1;
    stop if succeeded = 2;
  done;
  expect succeeded = 2;  -- two successful post-redo iterations
return;