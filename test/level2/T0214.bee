-- @DESC:T0214 Redo directive restarts current iteration (D14)
-- D14: `redo` re-evaluates the loop header without flushing volatile body state.
rule main:
  cycle:
    new attempts := 0;
    new succeeded := 0;
  do
    let attempts += 1;
    redo if attempts < 3;
    let succeeded += 1;
    stop if succeeded = 2;
  done;
  print succeeded;
return;

