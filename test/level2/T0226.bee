-- @FROZEN: Generated from /spec/. Immutable ground truth for AI agents.
-- @DESC: T0226 For cycle over a stepped domain (spec/02 §3.4.3)
-- `for i ∈ (1..9)(2)` materialises 1, 3, 5, 7, 9 (step 2, 1-based).
rule main:
  new total := 0;
  for i ∈ (1..9)(2) do
    let total := total + i;
  done;
  expect total = 25;
return;
