-- @DESC:T0209 Nested cycles with labels, inline jump and stop (D14)
-- D14: nested for/cycle blocks close with done; labels remain jump targets
-- for `stop outer` / `next outer` / `redo outer`.
rule main:
  cycle outer:
    new i ∈ Z;
  for i ∈ (1..3) do
    for j ∈ (1..3) do
      stop outer if i * j > 4;
      write i * j;
      next if i + j = 5;
    done;
  done outer;
  print;
return;

