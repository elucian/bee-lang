-- @DESC: Hello World with String variable
-- @AI: No - Self sufficient fast test
rule main:
  new s ∈ S; -- declare without initialization
  let s := "Hello World";
  let n := s;
  expect s  = n;  -- same value
  expect s is n;  -- same refference
  expect @s = @n; -- same pointer
  expect s = "Hello World";
  expect n = "Hello World";
return;