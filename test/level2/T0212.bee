-- @DESC: For cycle with inline next jump (skip evens) (D14)
-- @AI: No - Self sufficient fast test
-- D14: `next` is an inline transfer (continue), not a block terminator.
rule main:
  cycle:
    new total := 0;
  for i ∈ (1..10) do
    next if i % 2 = 0;
    let total := total + i;
  done;
  expect total = 25;  -- sum of odds 1+3+5+7+9, evens skipped
return;