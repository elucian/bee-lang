-- @FROZEN: Generated from /spec/02-statements.md §3.3. Immutable ground truth for AI agents.
-- @DESC:T0219 Match all evaluates every matching branch
rule main:
  new n := 2;
  new result := 0;
  match n all:
  when 2 do
    let result := result + 10;
  when 2 do
    let result := result + 5;
  when 3 do
    let result := result + 100;
  done;
  expect result = 15;
return;
