-- @DESC: Loop completion block with then epilogue (D14)
-- @AI: No - Self sufficient fast test
-- D14: `then` is the post-loop epilogue, runs once after loop exit.
-- Cycle closes with its done terminator after the then epilogue.
rule main:
  cycle main:
    new n := 0;
    while n < 3 do
      let n += 1;
  then
    expect n = 3;  -- then epilogue runs once after 3 iterations
  done main;
return;