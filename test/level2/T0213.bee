-- @DESC: Then epilogue runs once after stop (D14)
-- @AI: No - Self sufficient fast test
-- D14: `then` block executes exactly once after loop exit.
rule main:
  cycle counter:
    new n := 0;
  while n < 10 do
    let n += 1;
    stop if n = 5;
  then
    expect n = 5;  -- then runs once after stop at n=5
  done counter;
return;