-- @DISABLED: E0009 SyntaxError:UnrecognizedStatement: line=10 type=; literal=";"
-- @DESC:T0806 map-reduce with done terminators (D14)
-- D14: for terminators migrated to done;.
rule sum(a, b ∈ Z) => (r ∈ Z):
  for i ∈ (a..b) do:
    let r += i;
  done;
return;

rule main:
  new parts ∈ List(Z);
  for lo ∈ (1..76:25) do:
    begin sum(lo, lo + 24) +> parts;
  done;
  wait;

  new total := 0 ∈ Z;
  for ∀ p ∈ parts do:
    let total += p;
  done;
  print total;
return;

