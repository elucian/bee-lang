-- @DISABLED: E0009 SyntaxError:UnrecognizedStatement: line=4 type=; literal=";"
-- @DESC:T0805 independent loop with forall and done (D14)
-- For ∀ quantifier with done; terminator.
rule main:
  new squares ∈ [Z](6);
  for ∀ i ∈ (1..6) do:
    let squares[i] := i * i;
  done;
  print squares;
return;

