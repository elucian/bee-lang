-- @DESC: two coroutines taking turns (D14)
-- D14: loop terminators migrated to done;.
rule odds(n ∈ N) => (v ∈ N):
  for i ∈ (1..n) do:
    let v := i * 2 - 1;
    yield;
  done;
  let v := 0;
return;

rule evens(n ∈ N) => (v ∈ N):
  for i ∈ (1..n) do:
    let v := i * 2;
    yield;
  done;
  let v := 0;
return;

rule main:
  new a := 1 ∈ N;
  new b := 1 ∈ N;
  begin odds(3);
  begin evens(3);
  cycle while a > 0 do:
    yield a << odds;
    yield b << evens;
    write a + "/" + b + " ";
  done;
  print;
  wait;
return;
