-- @DESC:file: coroutines_turn.bee
-- Two coroutines taking turns demo
rule odds(n ∈ N) => (v ∈ N):
  for i ∈ (1..n) do:
    let v := i * 2 - 1;
    yield;
  repeat;
  let v := 0;
return;

rule evens(n ∈ N) => (v ∈ N):
  for i ∈ (1..n) do:
    let v := i * 2;
    yield;
  repeat;
  let v := 0;
return;

rule main:
  new a := 1 ∈ N;
  new b := 1 ∈ N;
  begin odds(3);
  begin evens(3);
  while a > 0 do:
    yield a << odds;
    yield b << evens;
    write a + "/" + b + " ";
  repeat;
  print;
  wait;
return;

