-- @DESC: coroutine with done terminator (D14)
-- D14: for loop terminates with done;.
rule ticker(n ∈ N) => (v ∈ N):
  for i ∈ (1..n) do:
    let v := i;
    yield;
  done;
  let v := 0;
return;

rule main:
  new r := 1 ∈ N;
  begin ticker(4);
  cycle while r > 0 do:
    yield r << ticker;
    write r;
  done;
  print;
  wait;
return;
