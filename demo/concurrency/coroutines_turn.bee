-- Two coroutines taking turns demo
rule odds(n ∈ N) => (v ∈ N):
  cycle:
    new i ∈ N;
  for i ∈ (1..n) do
    let v := i * 2 - 1;
    yield;
  repeat;
  let v := 0;
return;

rule evens(n ∈ N) => (v ∈ N):
  cycle:
    new i ∈ N;
  for i ∈ (1..n) do
    let v := i * 2;
    yield;
  repeat;
  let v := 0;
return;

rule main:
  begin odds(3);
  begin evens(3);
  cycle:
    new a ∈ N;
    new b ∈ N;
  do
    yield a << odds;
    yield b << evens;
    write a + "/" + b + " ";
  repeat if a > 0;
  print;
return;
